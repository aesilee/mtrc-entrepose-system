PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=mtrc_entrepose

JWT_SECRET=change_this_to_a_long_random_string
# Login expiry now comes from Settings -> Session timeout (minutes); JWT_EXPIRES_IN is no longer used.
# JWT_EXPIRES_IN=8h

# Used only by npm run seed:admin to create the first ICT Admin account
SEED_ADMIN_USERNAME=ictadmin
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FULLNAME=ICT Administrator

# Used only by npm run seed:him-staff to create the HIM Staff test account
HIM_STAFF_USERNAME=himstaff
HIM_STAFF_PASSWORD=ChangeMe123!
HIM_STAFF_FULLNAME=HIM Staff

# Case managers who share one caseload (comma-separated user IDs). Leave empty unless needed.
SHARED_CASELOAD_CM_IDS=
